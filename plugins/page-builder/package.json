{
  "name": "page-builder-mcp-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node tests/launcher-browser.test.mjs && node tests/browser.test.mjs && node tests/standalone-browser.test.mjs",
    "verify": "npm run build && npm run typecheck && npm test && npm run test:browser"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.62.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
