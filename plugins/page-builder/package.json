{
  "name": "page-builder-mcp-plugin",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts && node --test tests/mcp.test.mjs",
    "test:browser": "node tests/browser.test.mjs && node tests/standalone-export.test.mjs",
    "verify": "npm run clean && npm run build && npm run typecheck && npm test && npm run test:browser"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "fflate": "0.8.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.62.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
